<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <PackageId>MigrationSentinel</PackageId>
    <ToolCommandName>migration-sentinel</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Zero-downtime database migration guard for Entity Framework Core, SQL Server, and PostgreSQL. Detects breaking changes, table locks, and data loss via AST analysis and optional AI review.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MigrationSentinel.Core\MigrationSentinel.Core.csproj" />
    <ProjectReference Include="..\MigrationSentinel.Infrastructure\MigrationSentinel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
