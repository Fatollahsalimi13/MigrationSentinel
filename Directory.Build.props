<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>MigrationSentinel Contributors</Authors>
    <Company>MigrationSentinel</Company>
    <Copyright>Copyright (c) 2026 MigrationSentinel Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Fatollahsalimi13/MigrationSentinel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Fatollahsalimi13/MigrationSentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;efcore;migrations;sql;sqlserver;postgresql;devops;dba;static-analysis;ast;ai;cli;dotnet-tool</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
